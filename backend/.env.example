# Anthropic API key — required to generate personalized STAR questions and
# the final report. Without it, the backend falls back to local (heuristic) questions and report.
ANTHROPIC_API_KEY=

# Claude model used to generate questions and the report (optional)
ANTHROPIC_MODEL=claude-haiku-4-5

# Whisper model size: tiny, base, small, medium, large-v3 (optional, default: small)
WHISPER_MODEL=small

# Default Kokoro voice for Brazilian Portuguese (optional)
# Available pt-BR voices in Kokoro: pf_dora (female), pm_alex, pm_santa (male)
KOKORO_VOICE=pm_alex

# Default Kokoro voice for American English, used when the language is switched to 🇺🇸 (optional)
# Available English voices in Kokoro: af_heart, af_bella (female), am_adam, am_michael (male)
KOKORO_VOICE_EN=af_heart

# Set to 1 when running behind HTTPS; keep 0 for local http://localhost development.
AUTH_COOKIE_SECURE=0
