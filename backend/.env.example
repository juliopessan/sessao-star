# Chave da API da Anthropic — necessária para gerar perguntas STAR personalizadas
# e o relatório final. Sem ela, o backend usa perguntas e relatório locais (heurísticos).
ANTHROPIC_API_KEY=

# Modelo Claude usado para gerar perguntas e relatório (opcional)
ANTHROPIC_MODEL=claude-haiku-4-5

# Tamanho do modelo Whisper: tiny, base, small, medium, large-v3 (opcional, padrão: small)
WHISPER_MODEL=small

# Voz padrão do Kokoro para português do Brasil (opcional)
# Vozes pt-br disponíveis no Kokoro: pf_dora (feminina), pm_alex, pm_santa (masculinas)
KOKORO_VOICE=pm_alex

# Voz padrão do Kokoro para inglês americano, usada quando o idioma é trocado pra 🇺🇸 (opcional)
# Vozes em inglês disponíveis no Kokoro: af_heart, af_bella (femininas), am_adam, am_michael (masculinas)
KOKORO_VOICE_EN=af_heart
